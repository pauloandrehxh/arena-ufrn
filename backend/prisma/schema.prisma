// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PapelUsuario {
  ALUNO
  GESTOR
}

enum StatusReserva {
  ATIVA
  CANCELADA
  CONCLUIDA
}

model Quadra {
  id          Int       @id @default(autoincrement())
  name        String
  sport       String    @default("Vôlei de Praia / Futevôlei / Beach Tennis")
  description String    @default("")
  active      Boolean   @default(true)
  reservas    Reserva[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Usuario {
  id           Int          @id @default(autoincrement())
  name         String
  email        String       @unique
  registration String       @unique
  passwordHash String
  role         PapelUsuario @default(ALUNO)
  active       Boolean      @default(true)
  reservas     Reserva[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Reserva {
  id        Int           @id @default(autoincrement())
  date      DateTime
  startTime String
  endTime   String
  status    StatusReserva @default(ATIVA)

  usuarioId Int
  quadraId  Int

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  quadra  Quadra  @relation(fields: [quadraId], references: [id])

  createdAt DateTime @default(now())

  @@index([quadraId, date, status])
  @@index([usuarioId, date])
}
