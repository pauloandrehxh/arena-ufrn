# Banco de dados PostgreSQL 16
DATABASE_URL="postgresql://arena:arena_dev_password@localhost:5432/arena_ufrn?schema=public"

# Banco usado nos testes de integração reais (schemas isolados são criados e removidos automaticamente)
TEST_DATABASE_URL="postgresql://arena:arena_dev_password@localhost:5432/arena_ufrn"

# Segredo de assinatura JWT (em produção use ao menos 32 caracteres aleatórios)
JWT_SECRET="altere-esta-chave-em-producao-com-32-ou-mais-caracteres"

# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGINS="http://localhost:5173"

# Credenciais do seed inicial (opcional — usado apenas ao rodar `pnpm db:seed`)
SEED_ADMIN_EMAIL="gestor@ufrn.br"
SEED_ADMIN_PASSWORD="Arena@123"
